{
  "manifest_version": 3,
  "name": "EE Social Session Capture",
  "version": "0.1.0",
  "description": "Captures user-authorized social session state and stores it in the local project vault.",
  "permissions": [
    "activeTab",
    "cookies",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:47321/*",
    "https://149.28.133.149.sslip.io/*",
    "https://*.linkedin.com/*",
    "https://*.twitter.com/*",
    "https://*.x.com/*",
    "https://*.facebook.com/*",
    "https://*.instagram.com/*",
    "https://*.threads.net/*",
    "https://*.youtube.com/*",
    "https://*.google.com/*",
    "https://*.tiktok.com/*",
    "https://*.bsky.app/*",
    "https://*.mastodon.social/*",
    "https://web.telegram.org/*",
    "https://web.whatsapp.com/*"
  ],
  "action": {
    "default_title": "Capture social session",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "service-worker.js"
  }
}
